# Flask App Configuration
SECRET_KEY=your-super-secret-key-change-this
JWT_SECRET_KEY=your-jwt-secret-key-change-this
MAX_CONTENT_LENGTH=5242880  # 5MB in bytes

# Database Configuration
# Leave empty to use SQLite (local development instance/students.db)
# Set PostgreSQL connection URI for production (automatically falls back to SQLite if unreachable)
DATABASE_URL=postgresql://username:password@localhost:5432/bua_db?sslmode=prefer
PG_CONNECT_TIMEOUT=3
DB_POOL_MIN=5
DB_POOL_MAX=50
SESSION_COOKIE_SECURE=true  # Set to true when running with HTTPS in production
ENABLE_GDRIVE_SYNC=false     # Set to true to enable optional background mirroring to Google Drive

# MinIO S3 Storage Configuration
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=bua_minio_admin
MINIO_ROOT_PASSWORD=BuaMinioSecure@2026!
MINIO_BUCKET_NAME=student-photos
MINIO_PUBLIC_URL=https://id-storage.devhubai.net
MINIO_USE_SSL=false

# Email Configuration (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USE_TLS=false
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# University Configuration
UNIVERSITY_EMAIL_DOMAIN=university.edu.eg
SUPER_ADMIN_EMAIL=admin@university.edu.eg
SUPER_ADMIN_PASSWORD=change-this-to-secure-password



# Cloudinary Integration (Optional)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Google Drive Configuration (Primary Cloud Storage for Photos)
# Option A: Service Account (Recommended - no login required)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# or raw JSON string: GOOGLE_SERVICE_ACCOUNT_JSON=

# Option B: OAuth 2.0 (User Account)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=

# Google Drive Root Folder ID (Folder where photos will be stored)
# Open the folder in drive.google.com and copy the ID from the URL
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id

# Microsoft OneDrive Configuration (Legacy / Optional Backup)
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_TENANT_ID=common
ONEDRIVE_REFRESH_TOKEN=
ONEDRIVE_ROOT_FOLDER=badr_university

# Rate Limiting Configuration (Flask-Limiter)
# Format: "X per hour", "X per minute", "X per day"
LIMIT_AUTH_LOGIN=30 per hour
LIMIT_STUDENT_LOGIN=30 per hour
LIMIT_AUTH_REGISTER=30 per hour
LIMIT_AUTH_FORGOT=10 per hour
LIMIT_AUTH_RESEND=15 per hour
LIMIT_STAFF_REGISTER=300 per hour
LIMIT_UPDATE_PHOTO=30 per hour
LIMIT_STUDENT_REGISTER=30 per hour
LIMIT_API_LOGIN=60 per hour
