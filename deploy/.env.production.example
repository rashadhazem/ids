# ====================================================================
# BUA Student ID Portal – Production Environment Configuration
# ====================================================================

# 1. Flask & JWT Security (Generated high-entropy 256-bit keys)
SECRET_KEY=8c237336319517d9a49b10246d274aab71cee375e2c0c5462dbbf99e4a0cd4c8
JWT_SECRET_KEY=b7c6e8691a398c9f7065550739388cdbb8e85b40baa1136f078a9f7fb3f68365
MAX_CONTENT_LENGTH=5242880  # 5MB in bytes
SESSION_COOKIE_SECURE=false # Set to true once SSL (HTTPS) is activated

# 2. Local PostgreSQL Database on VPS (Lightning fast 0.5ms latency!)
DATABASE_URL=postgresql://bua_user:YOUR_DB_PASSWORD@localhost:5432/bua_db
PG_CONNECT_TIMEOUT=5
USE_NEON_HTTP=false

# 3. Super Admin Initial Account
SUPER_ADMIN_EMAIL=admin@university.edu.eg
SUPER_ADMIN_PASSWORD=Admin@2026!

# 4. University Configuration
UNIVERSITY_EMAIL_DOMAIN=bua.edu.eg

# 5. Production Server Tuning
PORT=5000
WEB_CONCURRENCY=3

# 6. SMTP Email Notifications (Optional for password resets)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# 7. Rate Limiting Calibrations
LIMIT_STAFF_REGISTER=500 per hour
LIMIT_STUDENT_REGISTER=200 per hour
LIMIT_STUDENT_LOGIN=3000 per hour
LIMIT_STAFF_LOGIN=500 per hour
LIMIT_FORGOT_PASSWORD=30 per hour
LIMIT_RESET_PASSWORD=30 per hour
LIMIT_API_LOGIN=500 per hour
LIMIT_UPDATE_PHOTO=200 per hour
